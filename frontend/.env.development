# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
# 本地 Docker 栈默认映射 backend 到 8088（见 docker-compose.yml BACKEND_PORT）
VITE_API_PROXY_URL = http://localhost:8088

# 菜单与路由：frontend=读本地 router 配置（联调 UI 改动）；backend=读 /api/v3/system/menus
VITE_ACCESS_MODE = frontend

# Delete console
VITE_DROP_CONSOLE = false