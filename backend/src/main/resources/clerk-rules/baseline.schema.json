{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomerClerkRuleBaseline",
  "type": "object",
  "required": ["customerCode", "rules"],
  "properties": {
    "customerCode": { "type": "string", "minLength": 1 },
    "customerName": { "type": "string" },
    "sourceVersion": { "type": "string" },
    "notes": { "type": "string" },
    "attachmentRefs": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/clerkRule" }
    }
  },
  "$defs": {
    "clerkRule": {
      "type": "object",
      "required": ["ruleType", "name", "stage"],
      "properties": {
        "ruleType": {
          "type": "string",
          "enum": [
            "DISCOUNT_OVERLAY",
            "PIECE_TIER_DISCOUNT",
            "FIXED_PRICE_EXPORT",
            "EXPORT_LAYOUT",
            "SETTLEMENT_DISCOUNT",
            "SEPARATE_PRICING_SYSTEM",
            "SETTLEMENT_MIN_CHARGE",
            "LOGISTICS_FEE",
            "LOGISTICS_WAIVE",
            "LOGISTICS_CARD_DEDUCT",
            "DEPT_SPLIT",
            "MERGED_SETTLEMENT",
            "GUOYAO_SETTLEMENT_FORMULA",
            "ZERO_ROW_PACKAGING_FEE",
            "MONTHLY_SUPPLEMENT_REPORT",
            "SETTLEMENT_PACK_SPLIT",
            "ATTACHMENT_REF",
            "BILL_EXPORT_PRICE_RULE",
            "PACK_NAME_PRICE",
            "PRICE_VALIDATE_ONLY"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "stage": {
          "type": "string",
          "enum": ["bill_export", "settlement", "both"]
        },
        "isActive": { "type": "boolean", "default": true },
        "priority": { "type": "integer" },
        "sourceText": { "type": "string" },
        "sourceRef": { "type": "string" },
        "scope": {
          "type": "object",
          "properties": {
            "temperature": { "type": "string", "enum": ["ANY", "HT", "LT"] },
            "keywords": { "type": "array", "items": { "type": "string" } },
            "acceptedTypes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "params": { "type": "object" }
      }
    }
  }
}
