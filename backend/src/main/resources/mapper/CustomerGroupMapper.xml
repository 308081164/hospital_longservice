<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.backend.mapper.CustomerGroupMapper">

    <resultMap id="CustomerGroupResultMap" type="com.hospital.backend.entity.CustomerGroup">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="groupType" column="group_type"/>
        <result property="config" column="config"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.backend.entity.CustomerGroup" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer_group (name, group_type, config, is_active, created_at, updated_at)
        VALUES (#{name}, #{groupType}, #{config}, #{isActive}, NOW(), NOW())
    </insert>

    <update id="updateById" parameterType="com.hospital.backend.entity.CustomerGroup">
        UPDATE customer_group
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="groupType != null">group_type = #{groupType},</if>
            config = #{config},
            <if test="isActive != null">is_active = #{isActive},</if>
            updated_at = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="CustomerGroupResultMap">
        SELECT * FROM customer_group WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="CustomerGroupResultMap">
        SELECT * FROM customer_group
        <where>
            <if test="groupType != null and groupType != ''">AND group_type = #{groupType}</if>
        </where>
        ORDER BY name ASC
    </select>

    <delete id="deleteById">
        DELETE FROM customer_group WHERE id = #{id}
    </delete>

</mapper>
