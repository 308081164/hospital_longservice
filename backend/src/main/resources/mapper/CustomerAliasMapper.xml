<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.backend.mapper.CustomerAliasMapper">

    <resultMap id="CustomerAliasResultMap" type="com.hospital.backend.entity.CustomerAlias">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="alias" column="alias"/>
        <result property="matchType" column="match_type"/>
        <result property="source" column="source"/>
        <result property="priority" column="priority"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.backend.entity.CustomerAlias" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer_alias (customer_id, alias, match_type, source, priority, is_active, created_at)
        VALUES (#{customerId}, #{alias}, #{matchType}, #{source}, #{priority}, #{isActive}, NOW())
    </insert>

    <delete id="deleteByCustomerId">
        DELETE FROM customer_alias WHERE customer_id = #{customerId}
    </delete>

    <select id="selectByCustomerId" resultMap="CustomerAliasResultMap">
        SELECT * FROM customer_alias WHERE customer_id = #{customerId} ORDER BY priority ASC, id ASC
    </select>

    <select id="selectAllActive" resultMap="CustomerAliasResultMap">
        SELECT * FROM customer_alias WHERE is_active = 1 ORDER BY priority ASC, id ASC
    </select>

    <select id="selectByAlias" resultMap="CustomerAliasResultMap">
        SELECT * FROM customer_alias WHERE alias = #{alias} LIMIT 1
    </select>

</mapper>
