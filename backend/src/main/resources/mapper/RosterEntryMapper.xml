<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.backend.mapper.RosterEntryMapper">

    <resultMap id="RosterEntryResultMap" type="com.hospital.backend.entity.RosterEntry">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="doctorName" column="doctor_name"/>
        <result property="department" column="department"/>
        <result property="surgicalRoom" column="surgical_room"/>
        <result property="notes" column="notes"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.backend.entity.RosterEntry" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO roster_entry (customer_id, doctor_name, department, surgical_room, notes, is_active, created_at, updated_at)
        VALUES (#{customerId}, #{doctorName}, #{department}, #{surgicalRoom}, #{notes}, #{isActive}, NOW(), NOW())
    </insert>

    <update id="updateById" parameterType="com.hospital.backend.entity.RosterEntry">
        UPDATE roster_entry
        SET doctor_name = #{doctorName},
            department = #{department},
            surgical_room = #{surgicalRoom},
            notes = #{notes},
            is_active = #{isActive},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM roster_entry WHERE id = #{id}
    </delete>

    <delete id="deleteByCustomerId">
        DELETE FROM roster_entry WHERE customer_id = #{customerId}
    </delete>

    <select id="selectById" resultMap="RosterEntryResultMap">
        SELECT * FROM roster_entry WHERE id = #{id}
    </select>

    <select id="selectByCustomerId" resultMap="RosterEntryResultMap">
        SELECT * FROM roster_entry
        WHERE customer_id = #{customerId}
        ORDER BY department ASC, doctor_name ASC
    </select>

    <select id="selectActiveByCustomerId" resultMap="RosterEntryResultMap">
        SELECT * FROM roster_entry
        WHERE customer_id = #{customerId} AND is_active = 1
        ORDER BY department ASC, doctor_name ASC
    </select>

</mapper>
