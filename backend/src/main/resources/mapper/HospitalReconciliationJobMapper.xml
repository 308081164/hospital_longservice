    <select id="selectById" resultMap="JobResultMap">
        SELECT * FROM hospital_reconciliation_job WHERE id = #{id}
    </select>

    <select id="existsById" resultType="boolean">
        SELECT COUNT(*) > 0 FROM hospital_reconciliation_job WHERE id = #{id}
    </select>

    <select id="selectByHospitalNameOrderByCreatedAtDesc" resultMap="JobListResultMap">
        SELECT id, hospital_name, source_file_name, source_file_path, source_file_size,
               rule_id, rule_name, plan_name, rule_version, version_no,
               total_rows, corrected_rows, unchanged_rows, warning_rows, skipped_rows,
               total_difference, review_status, review_comment, operator_name, reviewer_name,
               source_date_range, sheet_names, sheet_row_counts, sheet_warning_counts,
               logistics_trip_count, logistics_fee, logistics_breakdown,
               settlement_adjustment, monthly_breakdown, urgent_breakdown, deduction_breakdown,
               original_total_price, corrected_total_price,
               created_at, updated_at
        FROM hospital_reconciliation_job
        WHERE hospital_name = #{hospitalName}
        ORDER BY created_at DESC
    </select>

    <select id="selectAllOrderByCreatedAtDesc" resultMap="JobListResultMap">
        SELECT id, hospital_name, source_file_name, source_file_path, source_file_size,
               rule_id, rule_name, plan_name, rule_version, version_no,
               total_rows, corrected_rows, unchanged_rows, warning_rows, skipped_rows,
               total_difference, review_status, review_comment, operator_name, reviewer_name,
               source_date_range, sheet_names, sheet_row_counts, sheet_warning_counts,
               logistics_trip_count, logistics_fee, logistics_breakdown,
               settlement_adjustment, monthly_breakdown, urgent_breakdown, deduction_breakdown,
               original_total_price, corrected_total_price,
               created_at, updated_at
        FROM hospital_reconciliation_job
        ORDER BY created_at DESC
    </select>

    <select id="selectMaxVersionNoByHospitalName" resultType="integer">
        SELECT COALESCE(MAX(version_no), 0) FROM hospital_reconciliation_job WHERE hospital_name = #{hospitalName}
    </select>

    <select id="selectMaxVersionNoByHospitalNameAndSourceFileName" resultType="integer">
        SELECT COALESCE(MAX(version_no), 0)
        FROM hospital_reconciliation_job
        WHERE hospital_name = #{hospitalName}
          AND source_file_name = #{sourceFileName}
    </select>

    <update id="updateById" parameterType="com.hospital.backend.entity.HospitalReconciliationJob">
        UPDATE hospital_reconciliation_job
        <set>
            <if test="reviewStatus != null">review_status = #{reviewStatus},</if>
            <if test="reviewComment != null">review_comment = #{reviewComment},</if>
            <if test="reviewerName != null">reviewer_name = #{reviewerName},</if>
            <if test="totalRows != null">total_rows = #{totalRows},</if>
            <if test="correctedRows != null">corrected_rows = #{correctedRows},</if>
            <if test="unchangedRows != null">unchanged_rows = #{unchangedRows},</if>
            <if test="warningRows != null">warning_rows = #{warningRows},</if>
            <if test="skippedRows != null">skipped_rows = #{skippedRows},</if>
            <if test="totalDifference != null">total_difference = #{totalDifference},</if>
            <if test="rowsJson != null">rows_json = #{rowsJson},</if>
            updated_at = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateAllocationResult">
        UPDATE hospital_reconciliation_job
        SET allocation_result = #{allocationResult},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

