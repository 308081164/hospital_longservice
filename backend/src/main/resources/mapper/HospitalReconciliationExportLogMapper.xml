<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.backend.mapper.HospitalReconciliationExportLogMapper">

    <resultMap id="ExportLogResultMap" type="com.hospital.backend.entity.HospitalReconciliationExportLog">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="exportType" column="export_type"/>
        <result property="fileName" column="file_name"/>
        <result property="filePath" column="file_path"/>
        <result property="operatorName" column="operator_name"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.backend.entity.HospitalReconciliationExportLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO hospital_reconciliation_export_log (job_id, export_type, file_name, file_path, operator_name, created_at)
        VALUES (#{jobId}, #{exportType}, #{fileName}, #{filePath}, #{operatorName}, NOW())
    </insert>

    <select id="selectByJobIdOrderByCreatedAtAsc" resultMap="ExportLogResultMap">
        SELECT * FROM hospital_reconciliation_export_log WHERE job_id = #{jobId} ORDER BY created_at ASC
    </select>

</mapper>
