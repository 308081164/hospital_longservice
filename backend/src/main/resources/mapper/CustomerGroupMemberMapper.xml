<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.backend.mapper.CustomerGroupMemberMapper">

    <resultMap id="CustomerGroupMemberResultMap" type="com.hospital.backend.entity.CustomerGroupMember">
        <id property="id" column="id"/>
        <result property="groupId" column="group_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="shareRatio" column="share_ratio"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.backend.entity.CustomerGroupMember" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer_group_member (group_id, customer_id, share_ratio, created_at)
        VALUES (#{groupId}, #{customerId}, #{shareRatio}, NOW())
    </insert>

    <delete id="deleteByGroupId">
        DELETE FROM customer_group_member WHERE group_id = #{groupId}
    </delete>

    <delete id="deleteById">
        DELETE FROM customer_group_member WHERE id = #{id}
    </delete>

    <select id="selectByGroupId" resultMap="CustomerGroupMemberResultMap">
        SELECT * FROM customer_group_member WHERE group_id = #{groupId} ORDER BY id ASC
    </select>

    <select id="selectByCustomerId" resultMap="CustomerGroupMemberResultMap">
        SELECT * FROM customer_group_member WHERE customer_id = #{customerId}
    </select>

    <select id="selectByGroupAndCustomer" resultMap="CustomerGroupMemberResultMap">
        SELECT * FROM customer_group_member
        WHERE group_id = #{groupId} AND customer_id = #{customerId}
        LIMIT 1
    </select>

</mapper>
