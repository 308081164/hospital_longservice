<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.backend.mapper.HospitalPricingRuleRevisionMapper">

    <resultMap id="RevisionResultMap" type="com.hospital.backend.entity.HospitalPricingRuleRevision">
        <id property="id" column="id"/>
        <result property="ruleId" column="rule_id"/>
        <result property="version" column="version"/>
        <result property="rulesJson" column="rules_json"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.backend.entity.HospitalPricingRuleRevision" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO hospital_pricing_rule_revision (rule_id, version, rules_json, created_by, created_at)
        VALUES (#{ruleId}, #{version}, #{rulesJson}, #{createdBy}, NOW())
    </insert>

    <select id="selectByRuleId" resultMap="RevisionResultMap">
        SELECT * FROM hospital_pricing_rule_revision
        WHERE rule_id = #{ruleId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByRuleIdAndVersion" resultMap="RevisionResultMap">
        SELECT * FROM hospital_pricing_rule_revision
        WHERE rule_id = #{ruleId} AND version = #{version}
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <select id="selectById" resultMap="RevisionResultMap">
        SELECT * FROM hospital_pricing_rule_revision WHERE id = #{id}
    </select>

</mapper>
