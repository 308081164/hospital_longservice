# 复制为 .env 后填写（与 docker-compose.yml 同目录）。docker compose 会自动加载。
# 本地开发：docker compose up -d --build
# 需宿主机直连 MySQL：docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d

# ---------- MySQL（Compose 内置 mysql 服务）----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=hospital
MYSQL_USER=hospital
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# 仅 docker-compose.dev.yml：映射到宿主机的 MySQL 端口
# MYSQL_PUBLISH_PORT=3306

# ---------- 应用 ----------
# Base64URL HMAC 密钥，生成示例：
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
APP_JWT_SECRET=replace-with-base64url-secret

# 对外 HTTP 端口（浏览器访问 http://SERVER_IP:HTTP_PORT）
HTTP_PORT=8854

# 后端 API 直连端口（宿主机映射到容器 8000）
BACKEND_PUBLISH_PORT=8853

# 导出用公司银行信息（可选）
APP_COMPANY_BANK_ACCOUNT=
APP_COMPANY_BANK_NAME=

# ---------- 生产 / CI（docker-compose.prod.yml）----------
# 由 GitHub Actions 构建推送后注入，本地 prod 测试时可手动 export：
IMAGE_BACKEND=ghcr.io/<github-owner>/hospital-backend:latest
IMAGE_FRONTEND=ghcr.io/<github-owner>/hospital-frontend:latest

# backend 连库（默认 mysql:3306；容器间网络异常时可改网关绕行，见 deploy/docker-compose.prod.gateway.yml）
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_PUBLISH_PORT=3307

# 跳过 entrypoint SQL 清单迁移（调试用，一般勿设）
# SKIP_DB_MIGRATE=1
