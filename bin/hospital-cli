#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

find_python() {
  local cmd
  for cmd in python3.12 python3.11 python3.10 python3.9 python3; do
    if command -v "$cmd" >/dev/null 2>&1 \
      && "$cmd" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
      echo "$cmd"
      return 0
    fi
  done
  return 1
}

if PY=$(find_python); then
  exec "$PY" "$ROOT/scripts/hospital_cli.py" "$@"
fi

if [ -x "$ROOT/deploy/prod-smoke-bash.sh" ] && [ "${1:-}" = "smoke" ]; then
  shift
  exec "$ROOT/deploy/prod-smoke-bash.sh" "$@"
fi

echo "需要 Python 3.9+ 才能运行 hospital-cli（当前主机无可用解释器）" >&2
exit 127
