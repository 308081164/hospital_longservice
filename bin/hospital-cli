#!/usr/bin/env bash
# 本地/CI runner 使用；生产服务器 Post-deploy 请用 deploy/prod-smoke-docker.sh
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

find_python() {
  local cmd
  for cmd in python3.12 python3.11 python3.10 python3.9 python3; do
    if command -v "$cmd" >/dev/null 2>&1 \
      && "$cmd" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
      echo "$cmd"
      return 0
    fi
  done
  return 1
}

PY=$(find_python) || {
  echo "需要 Python 3.9+ 才能运行 hospital-cli" >&2
  exit 127
}

exec "$PY" "$ROOT/scripts/hospital_cli.py" "$@"
